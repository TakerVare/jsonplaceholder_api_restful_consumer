{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "JsonPlaceholderApi": "Information",
      "System.Net.Http.HttpClient": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": false,
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*",
  "JsonPlaceholderApi": {
    "BaseUrl": "https://jsonplaceholder.typicode.com/",
    "TimeoutSeconds": 30
  },
  "JwtSettings": {
    "SecretKey": "JsonPlaceholderApiSecretKey2024!MustBeAtLeast32Characters",
    "Issuer": "JsonPlaceholderApi",
    "Audience": "JsonPlaceholderApiClients",
    "ExpirationMinutes": 60
  }
}
